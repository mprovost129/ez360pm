# Section 1: Development
# Copy this file to .env. These values are safe local defaults; replace the
# secret and optional integration credentials on your workstation.

# Django / local URL
SECRET_KEY=development-only-change-me
DJANGO_SETTINGS_MODULE=config.Settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PUBLIC_BASE_URL=http://localhost:8000
TIME_ZONE=America/New_York
DJANGO_LOG_LEVEL=INFO
DJANGO_ROOT_LOG_LEVEL=WARNING
GUNICORN_TIMEOUT_SECONDS=180

# Local PostgreSQL / Redis
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ez360pm
DB_USER=ez360pm
DB_PASSWORD=local-development-only
DB_SSLMODE=
DB_CONN_MAX_AGE=0
REDIS_URL=redis://127.0.0.1:6379/1

# Development email and optional Stripe test credentials
EMAIL_PROVIDER=django
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EZ360PM Development <noreply@localhost>
DEFAULT_REPLY_TO_EMAIL=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI assistant: enable after adding a development API key.
AI_ASSISTANT_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
AI_MODEL=gpt-5.6-terra
AI_ALLOWED_MODELS=gpt-5.6-terra
AI_WARN_ON_UNPINNED_MODEL=true
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_BROWSER_REQUEST_TIMEOUT_SECONDS=195
AI_MAX_TOOL_ROUNDS=4
AI_MAX_TOOL_CALLS=4
AI_MAX_OUTPUT_TOKENS=3000
AI_REASONING_EFFORT=medium
AI_VERBOSITY=low
AI_FOCUSED_MAX_OUTPUT_TOKENS=600
AI_FOCUSED_REASONING_EFFORT=low
AI_FOCUSED_VERBOSITY=low
AI_MAX_PROMPT_CHARS=4000
AI_CONVERSATION_CONTEXT_TURNS=4
AI_CONVERSATION_CONTEXT_MINUTES=60
AI_MAX_REQUEST_BYTES=12000
AI_MAX_TOOL_OUTPUT_CHARS=40000
AI_REQUIRE_EXPLICIT_WRITE_INTENT=true
AI_RATE_LIMIT_REQUESTS=10
AI_LOCAL_ACTION_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_MONTHLY_COST_LIMIT_USD=10.00
AI_COMPANY_DEFAULT_ENABLED=true
AI_COMPANY_DEFAULT_EXTERNAL_COMMITS=true
AI_COMPANY_DEFAULT_PRIVACY_ACKNOWLEDGED=true
AI_COMPANY_DEFAULT_MONTHLY_REQUEST_LIMIT=500
AI_COMPANY_DEFAULT_RETENTION_DAYS=90
AI_COMPANY_DEFAULT_ACCESS_MODE=all_users
AI_COMPANY_DEFAULT_FAILURE_THRESHOLD=5
AI_COMPANY_DEFAULT_FAILURE_WINDOW_MINUTES=60
AI_INPUT_COST_PER_MILLION_USD=2.50
AI_OUTPUT_COST_PER_MILLION_USD=15.00
AI_MODEL_PRICING_JSON={"gpt-5.6-terra":{"input":2.50,"output":15.00}}
AI_PROACTIVE_INSIGHTS_ENABLED=true
AI_PROACTIVE_MAX_ITEMS=4
AI_PROACTIVE_DISMISS_DAYS=7
AI_PROACTIVE_REFRESH_SECONDS=3600
AI_DRAFT_STALE_DAYS=14
AI_FOLLOW_UP_MIN_INTERVAL_HOURS=24
AI_STALE_LEAD_DAYS=7
AI_FORGOTTEN_TIMER_HOURS=8
AI_READINESS_MAX_EVALUATION_AGE_DAYS=30

# Local media
USE_S3_MEDIA=False
MEDIA_ROOT=media
DJANGO_DEPLOY_CHECK_FAIL_LEVEL=ERROR
