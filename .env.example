# Django / public URL
SECRET_KEY=replace-with-a-long-random-secret
DJANGO_SETTINGS_MODULE=config.Settings.prod
ALLOWED_HOSTS=ez360pm.example.com,ez360pm.onrender.com
CSRF_TRUSTED_ORIGINS=https://ez360pm.example.com,https://ez360pm.onrender.com
PUBLIC_BASE_URL=https://ez360pm.example.com
TIME_ZONE=America/New_York
DJANGO_LOG_LEVEL=INFO
DJANGO_ROOT_LOG_LEVEL=WARNING

# PostgreSQL (use Render's individual connection values)
DB_HOST=replace-with-render-database-host
DB_PORT=5432
DB_NAME=replace-with-database-name
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# Redis
REDIS_URL=redis://replace-with-render-redis-url/1

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=Provost Home Design <noreply@example.com>

# Stripe (the publishable key is not used by server-hosted Stripe Checkout)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_FEE_RECONCILIATION_BATCH_SIZE=50

# Private customer-upload media on S3
USE_S3_MEDIA=True
AWS_ACCESS_KEY_ID=replace-with-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
AWS_STORAGE_BUCKET_NAME=replace-with-private-bucket-name
AWS_S3_REGION_NAME=us-east-1

# Used only when USE_S3_MEDIA=False
MEDIA_ROOT=media
