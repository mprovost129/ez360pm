# Section 2: Render production
# Add these values in the Render service Environment page. Replace every
# replace-* value. Do not upload a local .env file or commit live secrets.

# Django / Render URL
SECRET_KEY=replace-with-a-generated-64-byte-secret
DJANGO_SETTINGS_MODULE=config.Settings.prod
ALLOWED_HOSTS=replace-with-service.onrender.com
CSRF_TRUSTED_ORIGINS=https://replace-with-service.onrender.com
PUBLIC_BASE_URL=https://replace-with-service.onrender.com
TIME_ZONE=America/New_York
DJANGO_LOG_LEVEL=INFO
DJANGO_ROOT_LOG_LEVEL=WARNING
GUNICORN_TIMEOUT_SECONDS=180
WEB_CONCURRENCY=2

# Render PostgreSQL individual connection values
DB_HOST=replace-with-render-database-host
DB_PORT=5432
DB_NAME=replace-with-database-name
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# Render Key Value / Redis
REDIS_URL=redis://replace-with-render-redis-url/1

# Production transactional email (Resend HTTPS API)
EMAIL_PROVIDER=resend
EMAIL_BACKEND=core.email_backends.ResendEmailBackend
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=EZ360PM <replace-with-verified-sender@example.com>
DEFAULT_REPLY_TO_EMAIL=replace-with-google-workspace-address@example.com
RESEND_API_KEY=replace-with-resend-api-key
RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-signing-secret

# Stripe
STRIPE_SECRET_KEY=replace-with-stripe-live-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-live-webhook-secret
STRIPE_FEE_RECONCILIATION_BATCH_SIZE=50

# AI assistant: single-user PM/CRM production defaults
AI_ASSISTANT_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-render-secret-openai-key
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
AI_MODEL=gpt-5.6-terra
AI_ALLOWED_MODELS=gpt-5.6-terra
AI_WARN_ON_UNPINNED_MODEL=true
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_BROWSER_REQUEST_TIMEOUT_SECONDS=195
AI_MAX_TOOL_ROUNDS=4
AI_MAX_TOOL_CALLS=4
AI_MAX_OUTPUT_TOKENS=3000
AI_REASONING_EFFORT=medium
AI_VERBOSITY=low
AI_FOCUSED_MAX_OUTPUT_TOKENS=600
AI_FOCUSED_REASONING_EFFORT=low
AI_FOCUSED_VERBOSITY=low
AI_MAX_PROMPT_CHARS=4000
AI_CONVERSATION_CONTEXT_TURNS=4
AI_CONVERSATION_CONTEXT_MINUTES=60
AI_MAX_REQUEST_BYTES=12000
AI_MAX_TOOL_OUTPUT_CHARS=40000
AI_REQUIRE_EXPLICIT_WRITE_INTENT=true
AI_RATE_LIMIT_REQUESTS=10
AI_LOCAL_ACTION_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_MONTHLY_COST_LIMIT_USD=25.00
AI_COMPANY_DEFAULT_ENABLED=true
AI_COMPANY_DEFAULT_EXTERNAL_COMMITS=true
AI_COMPANY_DEFAULT_PRIVACY_ACKNOWLEDGED=true
AI_COMPANY_DEFAULT_MONTHLY_REQUEST_LIMIT=500
AI_COMPANY_DEFAULT_RETENTION_DAYS=90
AI_COMPANY_DEFAULT_ACCESS_MODE=all_users
AI_COMPANY_DEFAULT_FAILURE_THRESHOLD=5
AI_COMPANY_DEFAULT_FAILURE_WINDOW_MINUTES=60
AI_INPUT_COST_PER_MILLION_USD=2.50
AI_OUTPUT_COST_PER_MILLION_USD=15.00
AI_MODEL_PRICING_JSON={"gpt-5.6-terra":{"input":2.50,"output":15.00}}
AI_PROACTIVE_INSIGHTS_ENABLED=true
AI_PROACTIVE_MAX_ITEMS=4
AI_PROACTIVE_DISMISS_DAYS=7
AI_PROACTIVE_REFRESH_SECONDS=3600
AI_DRAFT_STALE_DAYS=14
AI_FOLLOW_UP_MIN_INTERVAL_HOURS=24
AI_STALE_LEAD_DAYS=7
AI_FORGOTTEN_TIMER_HOURS=8
AI_READINESS_MAX_EVALUATION_AGE_DAYS=30

# Private uploads. False requires a Render persistent disk mounted at /app/media.
USE_S3_MEDIA=False
MEDIA_ROOT=/app/media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
DJANGO_DEPLOY_CHECK_FAIL_LEVEL=ERROR
